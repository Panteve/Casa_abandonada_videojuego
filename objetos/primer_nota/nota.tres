[resource]
script = ExtResource("1_wyl47")
nombre = "Nota"
icono = ExtResource("1_tfnf5")
tipo = "nota"
contenido = "Espero que todavía recuerdes dónde guardaba mis cosas.

Dejé un cuchillo enterrado en la alacena. No es un accidente que esté allí; lo necesitarás para abrir uno de los gabinetes.

Dentro encontrarás algo que he mantenido oculto durante mucho tiempo. No confíes demasiado en lo que ves y, sobre todo, no olvides que algunas cosas es mejor dejarlas enterradas.

— Abuela Inés"
metadata/_custom_type_script = "uid://cp2bgmowlyi31"
