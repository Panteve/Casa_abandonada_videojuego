script = ExtResource("1_wyl47")
nombre = "Nota_cocina"
icono = ExtResource("1_tfnf5")
tipo = "nota"
contenido = "Lo que guardo no cede con las manos.

Busca lo afilado, clavado donde se guarda la comida.

Y no te quedes mucho a oscuras: algo en esta casa se acerca cuando la luz se apaga.

— Abuela Inés"
